# Скопируйте в .env и при необходимости измените.
# Загружается автоматически, если запускать через python-dotenv (см. README).

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b-instruct
LLM_TEMPERATURE=0.1

# --- Эмбеддинги ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Чанкование / поиск ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
COLLECTION_NAME=corporate_legal

# --- API-шлюз для OpenWebUI ---
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=rag-local
